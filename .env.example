# TiDB Cloud endpoint for local and production profiles.
DB_URL=jdbc:mysql://gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/trip_planner?sslMode=VERIFY_IDENTITY&connectionTimeZone=SERVER

# Set these locally; never commit populated values.
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=

DB_DRIVER=com.mysql.cj.jdbc.Driver
JWT_EXPIRATION_MS=86400000
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
